# Copy to /opt/dashboard/.env on the VM (mode 600) and fill in the blanks.
# Never commit the real file. Generate the password with: openssl rand -hex 24

ENVIRONMENT=production
POSTGRES_PASSWORD=
IMAGE_TAG=latest

# Public HTTPS (Caddy). Leave COMPOSE_PROFILES empty on a staging VM that has no public hostname.
COMPOSE_PROFILES=public
API_DOMAIN=api.dashboard.aims-umich.com
API_CORS_ORIGINS=https://dashboard.aims-umich.com

# Which collectors run. Add "reddit" once Reddit approves API access, and "youtube" only with
# YouTube Researcher Program access (the standard API forbids aggregation and derived metrics).
ENABLED_SOURCES=bluesky,mastodon,guardian,nyt

# Keys (all free tiers)
GUARDIAN_API_KEY=
NYT_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Only for Mastodon instances that require a token for hashtag timelines: "instance=token,..."
MASTODON_ACCESS_TOKENS=

# Scorer: one core for BERT leaves the second for Postgres, ingest, and the API.
SCORER_THREADS=1

# Monitoring (optional, free tiers)
HEALTHCHECKS_PING_KEY=
SENTRY_DSN=

# Backups: an age public key (the private key stays offline), and rclone remotes to copy to.
# Configure remotes with `rclone config` on the VM; separate several with spaces and quote the value,
# for example BACKUP_REMOTES="oci:dashboard-backups gdrive:aims/backups".
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTES=
